{
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#171C24", "editor.foreground": "#E8EEF0",
    "editorGroupHeader.tabsBackground": "#171C24", "tab.activeBackground": "#171C24", "tab.inactiveBackground": "#1A222B",
    "tab.activeForeground": "#E8EEF0", "tab.inactiveForeground": "#8A9BA3",
    "tab.activeBorderTop": "#FF9B70", "tab.border": "#2D3D46", "tab.hoverBackground": "#1D2730",
    "sideBar.background": "#1D2530", "sideBar.foreground": "#E8EEF0", "sideBarTitle.foreground": "#E8EEF0",
    "sideBarSectionHeader.background": "#202F39", "sideBarSectionHeader.foreground": "#56B4E9",
    "activityBar.background": "#202F39", "activityBar.foreground": "#56B4E9", "activityBar.inactiveForeground": "#8A9BA3",
    "activityBar.activeBorder": "#FF9B70", "activityBarBadge.background": "#E05A2A", "activityBarBadge.foreground": "#FFFFFF",
    "titleBar.activeBackground": "#1D2530", "titleBar.activeForeground": "#E8EEF0",
    "titleBar.inactiveBackground": "#1A222B", "titleBar.inactiveForeground": "#8A9BA3",
    "statusBar.background": "#15545A", "statusBar.foreground": "#E6FFFC",
    "statusBarItem.hoverBackground": "#1C6268",
    "statusBarItem.remoteBackground": "#0E3E43", "statusBarItem.remoteForeground": "#E6FFFC",
    "statusBar.debuggingBackground": "#5E3F10", "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#1D2530", "statusBar.noFolderForeground": "#E8EEF0",
    "editor.lineHighlightBackground": "#1D2730", "editor.lineHighlightBorder": "#243C43",
    "editor.selectionBackground": "#244D55", "editor.selectionHighlightBackground": "#2E5A63",
    "editor.findMatchBackground": "#63500A", "editor.findMatchHighlightBackground": "#3B3A20", "editor.findMatchBorder": "#E69F00",
    "editorCursor.foreground": "#E69F00",
    "editorLineNumber.foreground": "#6E828C", "editorLineNumber.activeForeground": "#56B4E9", "editorWhitespace.foreground": "#2D3D46",
    "focusBorder": "#FF9B70",
    "list.activeSelectionBackground": "#254A50", "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#22333B", "list.inactiveSelectionForeground": "#E8EEF0",
    "list.hoverBackground": "#24323C", "list.hoverForeground": "#E8EEF0",
    "list.focusBackground": "#23444A", "list.focusForeground": "#FFFFFF", "list.focusOutline": "#FF9B70",
    "list.highlightForeground": "#56B4E9",
    "quickInput.background": "#1D2530", "quickInput.foreground": "#E8EEF0", "quickInputTitle.background": "#202F39",
    "pickerGroup.foreground": "#56B4E9", "pickerGroup.border": "#2D3D46",
    "quickInputList.focusBackground": "#254A50", "quickInputList.focusForeground": "#FFFFFF", "quickInputList.focusIconForeground": "#FFFFFF",
    "menu.background": "#1D2530", "menu.foreground": "#E8EEF0", "menu.selectionBackground": "#254A50",
    "menu.selectionForeground": "#FFFFFF", "menu.separatorBackground": "#2D3D46", "menu.border": "#2D3D46",
    "dropdown.background": "#202A34", "dropdown.foreground": "#E8EEF0", "dropdown.border": "#2D3D46", "dropdown.listBackground": "#1D2530",
    "input.background": "#1A222B", "input.foreground": "#E8EEF0", "input.border": "#2D3D46", "input.placeholderForeground": "#8A9BA3",
    "button.background": "#15545A", "button.foreground": "#FFFFFF", "button.hoverBackground": "#1C6268",
    "badge.background": "#E05A2A", "badge.foreground": "#FFFFFF",
    "editorWidget.background": "#1D2530", "editorWidget.foreground": "#E8EEF0", "editorWidget.border": "#2D3D46",
    "editorHoverWidget.background": "#1D2530", "editorHoverWidget.foreground": "#E8EEF0", "editorHoverWidget.border": "#2D3D46",
    "panel.background": "#1A222B", "peekView.border": "#56B4E9",
    "editorError.foreground": "#FF6B88", "editorWarning.foreground": "#F0E442", "editorInfo.foreground": "#56B4E9",
    "editorBracketMatch.background": "#214B52", "editorBracketMatch.border": "#56B4E9",
    "editorIndentGuide.background1": "#293943", "editorIndentGuide.activeBackground1": "#46777A",
    "editorOverviewRuler.border": "#2D3D46", "minimap.background": "#1A232C",
    "editor.wordHighlightBackground": "#243C43", "editor.wordHighlightStrongBackground": "#285057",
    "diffEditor.insertedTextBackground": "#1E3A2F", "diffEditor.removedTextBackground": "#3D222B",
    "diffEditor.insertedLineBackground": "#1C332A", "diffEditor.removedLineBackground": "#38222A",
    "editorBracketHighlight.foreground1": "#56B4E9", "editorBracketHighlight.foreground2": "#E69F00",
    "editorBracketHighlight.foreground3": "#CC79A7",
    "editorBracketPairGuide.activeBackground1": "#56B4E9", "editorBracketPairGuide.activeBackground2": "#E69F00",
    "editorBracketPairGuide.activeBackground3": "#CC79A7",
    "editorInlayHint.background": "#24323C", "editorInlayHint.foreground": "#A8B9C0", "editorInlayHint.border": "#2D3D46",
    "editorInlayHint.typeBackground": "#232F4A", "editorInlayHint.typeForeground": "#B9C6FF",
    "editorInlayHint.parameterBackground": "#1E3A2F", "editorInlayHint.parameterForeground": "#7FD8B8",
    "editorCodeLens.foreground": "#56B4E9",
    "editorStickyScroll.background": "#1D2530", "editorStickyScrollHover.background": "#24323C",
    "editorStickyScroll.border": "#2D3D46",
    "breadcrumb.background": "#171C24", "breadcrumb.foreground": "#8A9BA3", "breadcrumb.focusForeground": "#E8EEF0",
    "breadcrumb.activeSelectionForeground": "#56B4E9", "breadcrumbPicker.background": "#1D2530",
    "editorGhostText.foreground": "#6E828C", "editorGhostText.border": "#2D3D46",
    "symbolIcon.classForeground": "#CC79A7", "symbolIcon.interfaceForeground": "#CC79A7", "symbolIcon.structForeground": "#CC79A7",
    "symbolIcon.methodForeground": "#E69F00", "symbolIcon.functionForeground": "#E69F00", "symbolIcon.constructorForeground": "#E69F00",
    "symbolIcon.variableForeground": "#2ABF8E", "symbolIcon.fieldForeground": "#7ACFF0", "symbolIcon.propertyForeground": "#7ACFF0",
    "symbolIcon.constantForeground": "#F0E442", "symbolIcon.enumMemberForeground": "#F0E442", "symbolIcon.enumeratorForeground": "#F0E442",
    "symbolIcon.stringForeground": "#9BE28C", "symbolIcon.numberForeground": "#F0E442", "symbolIcon.booleanForeground": "#F0E442",
    "symbolIcon.namespaceForeground": "#56B4E9", "symbolIcon.moduleForeground": "#56B4E9", "symbolIcon.packageForeground": "#56B4E9",
    "symbolIcon.keywordForeground": "#B9C6FF",
    "terminal.background": "#171C24", "terminal.foreground": "#E8EEF0", "terminalCursor.foreground": "#E69F00",
    "terminal.selectionBackground": "#244D55",
    "terminal.ansiBlack": "#2D3D46", "terminal.ansiRed": "#EE7B40", "terminal.ansiGreen": "#2ABF8E", "terminal.ansiYellow": "#F0E442",
    "terminal.ansiBlue": "#56B4E9", "terminal.ansiMagenta": "#CC79A7", "terminal.ansiCyan": "#7ACFF0", "terminal.ansiWhite": "#E8EEF0",
    "terminal.ansiBrightBlack": "#586A74", "terminal.ansiBrightRed": "#FF9B70", "terminal.ansiBrightGreen": "#5FE0AC",
    "terminal.ansiBrightYellow": "#F7E572", "terminal.ansiBrightBlue": "#8FDCF7", "terminal.ansiBrightMagenta": "#E3A9D4",
    "terminal.ansiBrightCyan": "#A5E4F5", "terminal.ansiBrightWhite": "#FFFFFF",
    "merge.currentHeaderBackground": "#244D55", "merge.currentContentBackground": "#1E3238",
    "merge.incomingHeaderBackground": "#4A3A10", "merge.incomingContentBackground": "#2C270F",
    "merge.commonContentBackground": "#1A222B", "merge.border": "#2D3D46"
  },
  "semanticTokenColors": {
    "function": { "foreground": "#E69F00", "fontStyle": "bold" },
    "method": { "foreground": "#E69F00" },
    "class": { "foreground": "#CC79A7", "fontStyle": "bold" },
    "interface": { "foreground": "#CC79A7" },
    "struct": { "foreground": "#CC79A7" },
    "type": { "foreground": "#CC79A7", "fontStyle": "bold" },
    "namespace": "#56B4E9", "variable": "#2ABF8E", "parameter": { "foreground": "#7FD8B8", "fontStyle": "italic" },
    "property": "#7ACFF0", "enumMember": "#F0E442", "decorator": "#CC79A7",
    "macro": "#B9C6FF", "keyword": "#B9C6FF", "comment": "#819099",
    "*.declaration": { "fontStyle": "bold" },
    "*.readonly": { "fontStyle": "italic" },
    "*.async": { "fontStyle": "italic" },
    "*.deprecated": { "fontStyle": "strikethrough" }
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#819099", "fontStyle": "italic" } },
    { "scope": ["comment.block.documentation", "comment.block", "string.quoted.docstring"], "settings": { "foreground": "#8A9BA3" } },
    { "scope": ["keyword", "storage", "keyword.control"], "settings": { "foreground": "#B9C6FF" } },
    { "scope": ["keyword.control.import", "keyword.control.from", "keyword.other.import", "entity.name.namespace", "support.other"], "settings": { "foreground": "#56B4E9" } },
    { "scope": ["entity.name.import", "entity.name.module", "entity.name.package", "support.module", "support.package"], "settings": { "foreground": "#56B4E9", "fontStyle": "underline bold" } },
    { "scope": ["entity.name.function", "entity.name.function.method", "support.function", "variable.function"], "settings": { "foreground": "#E69F00", "fontStyle": "bold" } },
    { "scope": ["meta.function-call", "entity.name.function.call"], "settings": { "foreground": "#E69F00" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.interface", "support.class", "storage.type"], "settings": { "foreground": "#CC79A7", "fontStyle": "bold" } },
    { "scope": ["variable", "support.variable", "variable.other.readwrite", "variable.parameter"], "settings": { "foreground": "#2ABF8E" } },
    { "scope": ["variable.parameter", "meta.function.parameters"], "settings": { "foreground": "#7FD8B8", "fontStyle": "italic" } },
    { "scope": ["meta.object-literal.key", "entity.name.tag", "entity.other.attribute-name", "support.type.property-name"], "settings": { "foreground": "#7ACFF0" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#9BE28C" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "#F0E442" } },
    { "scope": ["constant", "entity.name.constant"], "settings": { "foreground": "#F0E442" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#A8B9C0" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#7ACFF0" } },
    { "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"], "settings": { "foreground": "#CC79A7" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF6B88", "fontStyle": "bold underline" } }
  ]
}
