{
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#FBFAF7", "editor.foreground": "#263238",
    "editorGroupHeader.tabsBackground": "#FBFAF7", "tab.activeBackground": "#FBFAF7", "tab.inactiveBackground": "#F1F4F3",
    "tab.activeForeground": "#263238", "tab.inactiveForeground": "#5D6F74",
    "tab.activeBorderTop": "#E05A2A", "tab.border": "#D7E2E0", "tab.hoverBackground": "#EAF1EF",
    "sideBar.background": "#F1F4F3", "sideBar.foreground": "#263238", "sideBarTitle.foreground": "#263238",
    "sideBarSectionHeader.background": "#E7EEEC", "sideBarSectionHeader.foreground": "#0B3D40",
    "activityBar.background": "#E7EEEC", "activityBar.foreground": "#0E6C70", "activityBar.inactiveForeground": "#5D6F74",
    "activityBar.activeBorder": "#E05A2A", "activityBarBadge.background": "#E05A2A", "activityBarBadge.foreground": "#FFFFFF",
    "titleBar.activeBackground": "#EAF1EF", "titleBar.activeForeground": "#263238", "titleBar.inactiveBackground": "#F1F4F3",
    "titleBar.inactiveForeground": "#5D6F74",
    "statusBar.background": "#0E6C70", "statusBar.foreground": "#FFFFFF",
    "statusBarItem.hoverBackground": "#167C80",
    "statusBarItem.remoteBackground": "#0A5054", "statusBarItem.remoteForeground": "#FFFFFF",
    "statusBar.debuggingBackground": "#7A4A1E", "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#F1F4F3", "statusBar.noFolderForeground": "#263238",
    "editor.lineHighlightBackground": "#F1F7F5", "editor.lineHighlightBorder": "#D8ECE9",
    "editor.selectionBackground": "#BDE8E2", "editor.selectionHighlightBackground": "#D5EBE7",
    "editor.findMatchBackground": "#FFD48A", "editor.findMatchHighlightBackground": "#FFE9C2", "editor.findMatchBorder": "#A65408",
    "editorCursor.foreground": "#C74313",
    "editorLineNumber.foreground": "#5D6F74", "editorLineNumber.activeForeground": "#0E6C70", "editorWhitespace.foreground": "#B9CBC8",
    "focusBorder": "#E05A2A",
    "list.activeSelectionBackground": "#0E6C70", "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#CDEAE5", "list.inactiveSelectionForeground": "#0B3D40",
    "list.hoverBackground": "#E4F1EF", "list.hoverForeground": "#0B3D40",
    "list.focusBackground": "#CDEAE5", "list.focusForeground": "#0B3D40", "list.focusOutline": "#E05A2A",
    "list.highlightForeground": "#0E6C70",
    "quickInput.background": "#FFFFFF", "quickInput.foreground": "#263238", "quickInputTitle.background": "#EAF1EF",
    "pickerGroup.foreground": "#0E6C70", "pickerGroup.border": "#D7E2E0",
    "quickInputList.focusBackground": "#0E6C70", "quickInputList.focusForeground": "#FFFFFF", "quickInputList.focusIconForeground": "#FFFFFF",
    "menu.background": "#FFFFFF", "menu.foreground": "#263238", "menu.selectionBackground": "#0E6C70",
    "menu.selectionForeground": "#FFFFFF", "menu.separatorBackground": "#D7E2E0", "menu.border": "#D7E2E0",
    "dropdown.background": "#FFFFFF", "dropdown.foreground": "#263238", "dropdown.border": "#D7E2E0", "dropdown.listBackground": "#FFFFFF",
    "input.background": "#FFFFFF", "input.foreground": "#263238", "input.border": "#D7E2E0", "input.placeholderForeground": "#5D6F74",
    "button.background": "#0E6C70", "button.foreground": "#FFFFFF", "button.hoverBackground": "#167C80",
    "badge.background": "#E05A2A", "badge.foreground": "#FFFFFF",
    "editorWidget.background": "#FFFFFF", "editorWidget.foreground": "#263238", "editorWidget.border": "#D7E2E0",
    "editorHoverWidget.background": "#FFFFFF", "editorHoverWidget.foreground": "#263238", "editorHoverWidget.border": "#D7E2E0",
    "panel.background": "#F5F8F7", "peekView.border": "#0E6C70",
    "editorError.foreground": "#C22048", "editorWarning.foreground": "#8A5700", "editorInfo.foreground": "#076A8A",
    "editorBracketMatch.background": "#D8F1EC", "editorBracketMatch.border": "#0E6C70",
    "editorIndentGuide.background1": "#DDE8E6", "editorIndentGuide.activeBackground1": "#7FBFB6",
    "editorOverviewRuler.border": "#D7E2E0", "minimap.background": "#F3F7F5",
    "editor.wordHighlightBackground": "#E7F3EF", "editor.wordHighlightStrongBackground": "#D5EBE7",
    "diffEditor.insertedTextBackground": "#D9F0E4", "diffEditor.removedTextBackground": "#FADFE3",
    "diffEditor.insertedLineBackground": "#E6F6ED", "diffEditor.removedLineBackground": "#FCEBEF",
    "editorBracketHighlight.foreground1": "#0E6C70", "editorBracketHighlight.foreground2": "#C74313",
    "editorBracketHighlight.foreground3": "#A92584",
    "editorBracketPairGuide.activeBackground1": "#0E6C70", "editorBracketPairGuide.activeBackground2": "#C74313",
    "editorBracketPairGuide.activeBackground3": "#A92584",
    "editorInlayHint.background": "#EAF1EF", "editorInlayHint.foreground": "#0B3D40", "editorInlayHint.border": "#D7E2E0",
    "editorInlayHint.typeBackground": "#E4EAFB", "editorInlayHint.typeForeground": "#3D4E9E",
    "editorInlayHint.parameterBackground": "#EAF6F3", "editorInlayHint.parameterForeground": "#177A4E",
    "editorCodeLens.foreground": "#0E6C70",
    "editorStickyScroll.background": "#F1F4F3", "editorStickyScrollHover.background": "#E7EEEC",
    "editorStickyScroll.border": "#D7E2E0",
    "breadcrumb.background": "#FBFAF7", "breadcrumb.foreground": "#5D6F74", "breadcrumb.focusForeground": "#263238",
    "breadcrumb.activeSelectionForeground": "#0E6C70", "breadcrumbPicker.background": "#FFFFFF",
    "editorGhostText.foreground": "#8B9A9E", "editorGhostText.border": "#D7E2E0",
    "symbolIcon.classForeground": "#A92584", "symbolIcon.interfaceForeground": "#9330A0", "symbolIcon.structForeground": "#9330A0",
    "symbolIcon.methodForeground": "#A65408", "symbolIcon.functionForeground": "#C74313", "symbolIcon.constructorForeground": "#C74313",
    "symbolIcon.variableForeground": "#177A4E", "symbolIcon.fieldForeground": "#0B5F8A", "symbolIcon.propertyForeground": "#0B5F8A",
    "symbolIcon.constantForeground": "#8A5700", "symbolIcon.enumMemberForeground": "#8A5700", "symbolIcon.enumeratorForeground": "#8A5700",
    "symbolIcon.stringForeground": "#237A3E", "symbolIcon.numberForeground": "#8A5700", "symbolIcon.booleanForeground": "#8A5700",
    "symbolIcon.namespaceForeground": "#076A8A", "symbolIcon.moduleForeground": "#076A8A", "symbolIcon.packageForeground": "#076A8A",
    "symbolIcon.keywordForeground": "#5F36B8",
    "terminal.background": "#FBFAF7", "terminal.foreground": "#263238", "terminalCursor.foreground": "#C74313",
    "terminal.selectionBackground": "#BDE8E2",
    "terminal.ansiBlack": "#263238", "terminal.ansiRed": "#C22048", "terminal.ansiGreen": "#237A3E", "terminal.ansiYellow": "#8A5700",
    "terminal.ansiBlue": "#076A8A", "terminal.ansiMagenta": "#A92584", "terminal.ansiCyan": "#0E6C70", "terminal.ansiWhite": "#5D6F74",
    "terminal.ansiBrightBlack": "#6E7F83", "terminal.ansiBrightRed": "#D92950", "terminal.ansiBrightGreen": "#2C8A49",
    "terminal.ansiBrightYellow": "#A76500", "terminal.ansiBrightBlue": "#087EA4", "terminal.ansiBrightMagenta": "#B52D8A",
    "terminal.ansiBrightCyan": "#167C80", "terminal.ansiBrightWhite": "#263238",
    "merge.currentHeaderBackground": "#BDE8E2", "merge.currentContentBackground": "#E7F3EF",
    "merge.incomingHeaderBackground": "#FFE0A6", "merge.incomingContentBackground": "#FFF4DE",
    "merge.commonContentBackground": "#F1F4F3", "merge.border": "#D7E2E0"
  },
  "semanticTokenColors": {
    "function": { "foreground": "#C74313", "fontStyle": "bold" },
    "method": { "foreground": "#A65408" },
    "class": { "foreground": "#A92584", "fontStyle": "bold" },
    "interface": { "foreground": "#9330A0" },
    "struct": { "foreground": "#9330A0" },
    "type": { "foreground": "#A92584", "fontStyle": "bold" },
    "namespace": "#076A8A", "variable": "#177A4E", "parameter": { "foreground": "#177A4E", "fontStyle": "italic" },
    "property": "#0B5F8A", "enumMember": "#8A5700", "decorator": "#9330A0",
    "macro": "#6A3FB0", "keyword": "#5F36B8", "comment": "#5D6F74",
    "*.declaration": { "fontStyle": "bold" },
    "*.readonly": { "fontStyle": "italic" },
    "*.async": { "fontStyle": "italic" },
    "*.deprecated": { "fontStyle": "strikethrough" }
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5D6F74", "fontStyle": "italic" } },
    { "scope": ["comment.block.documentation", "comment.block", "string.quoted.docstring"], "settings": { "foreground": "#3E5257" } },
    { "scope": ["keyword", "storage", "keyword.control"], "settings": { "foreground": "#5F36B8" } },
    { "scope": ["keyword.control.import", "keyword.control.from", "keyword.other.import", "entity.name.namespace", "support.other"], "settings": { "foreground": "#076A8A" } },
    { "scope": ["entity.name.import", "entity.name.module", "entity.name.package", "support.module", "support.package"], "settings": { "foreground": "#076A8A", "fontStyle": "underline bold" } },
    { "scope": ["entity.name.function", "entity.name.function.method", "support.function", "variable.function"], "settings": { "foreground": "#C74313", "fontStyle": "bold" } },
    { "scope": ["meta.function-call", "entity.name.function.call"], "settings": { "foreground": "#A65408" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.interface", "support.class", "storage.type"], "settings": { "foreground": "#A92584", "fontStyle": "bold" } },
    { "scope": ["variable", "support.variable", "variable.other.readwrite", "variable.parameter"], "settings": { "foreground": "#177A4E" } },
    { "scope": ["variable.parameter", "meta.function.parameters"], "settings": { "foreground": "#177A4E", "fontStyle": "italic" } },
    { "scope": ["meta.object-literal.key", "entity.name.tag", "entity.other.attribute-name", "support.type.property-name"], "settings": { "foreground": "#0B5F8A" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#237A3E" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "#8A5700" } },
    { "scope": ["constant", "entity.name.constant"], "settings": { "foreground": "#8A5700" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#4E6066" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#0B5F8A" } },
    { "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"], "settings": { "foreground": "#9330A0" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#C22048", "fontStyle": "bold underline" } }
  ]
}
